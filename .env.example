# App
NODE_ENV=production
AUTH_SECRET=replace_with_a_long_random_secret
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=replace_with_a_long_random_secret
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME="Be My Traveller"

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bemytraveller

# Admin bootstrap
BMT_ADMIN_EMAIL=admin@bemytraveller.com
BMT_ADMIN_PASSWORD=change_this_password_before_launch
BMT_MASTER_PASSWORDS=change_this_password_before_launch
SEED_SECRET=replace_with_a_random_seed_token

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key

# Storage (unused in the current build)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# NEXT_PUBLIC_R2_PUBLIC_URL=
