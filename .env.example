# ── Application URL ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.bemytraveller.com
NEXT_PUBLIC_APP_NAME="Be My Traveller"

# ── MongoDB Atlas Database ───────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bemytraveller?retryWrites=true&w=majority

# ── NextAuth v5 Authentication ───────────────────────────────
AUTH_SECRET=generate_32_chars_base64_secret_key_here
NEXTAUTH_SECRET=generate_32_chars_base64_secret_key_here
NEXTAUTH_URL=https://www.bemytraveller.com

# ── Cloudinary Media Management ──────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Cloudflare R2 Storage (Optional) ─────────────────────────
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.bemytraveller.com
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=bemytraveller-media

# ── Payment Gateway (Razorpay) ───────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Outbound SMTP Email ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@bemytraveller.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@bemytraveller.com
SMTP_FROM_NAME="Be My Traveller Holidays"

# ── Meta WhatsApp Cloud API ──────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_TOKEN=your_meta_system_token

NODE_ENV=production
